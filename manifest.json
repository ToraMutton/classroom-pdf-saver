{
    "manifest_version": 3,
    "name": "Classroom PDF Saver",
    "version": "2.0",
    "description": "Google Classroomの資料を選んで好きなフォルダに保存",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://classroom.google.com/*",
        "https://drive.google.com/*",
        "https://drive.usercontent.google.com/*",
        "https://docs.google.com/*",
        "https://*.googleusercontent.com/*"
    ],
    "action": {
        "default_title": "資料を保存",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "manage.html",
        "open_in_tab": true
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
